{
  "manifest_version": 3,
  "name": "Novel RSVP",
  "version": "0.2.0",
  "description": "Read web novels word by word in a calm reader panel on the page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Novel RSVP (Alt+R)" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+R" }, "description": "Open the reader" }
  }
}
